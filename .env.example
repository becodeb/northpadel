# Puerto del servidor (API + WS + estáticos en producción)
PORT=3000

# Base de datos. Si DATABASE_URL está vacío se usa PGlite (Postgres embebido) en ./data/pglite
# DATABASE_URL=postgres://user:pass@host:5432/northpadel

# Secreto para firmar cookies de sesión (cambiar en producción)
SESSION_SECRET=north-padel-dev-secret-change-me

# Usuario administrador inicial (se crea si no existe)
ADMIN_EMAIL=admin@northpadel.com
ADMIN_PASSWORD=northpadel
ADMIN_NAME=Organizador

# URL pública (para QR y links compartidos). Si está vacío se usa el origin del navegador.
# PUBLIC_URL=https://padel.becode.com.ar
